---
import Base from '../layouts/Base.astro';
---
<Base title="Careers" description="Join a self-performing EV and BESS crew. Journeyman, apprentice (WECA) and office roles." path="/careers/">
<section id="careers"><div class="wrap">
  <div class="careers">
    <div class="sec-head" style="margin-bottom:0">
      <p class="label">Careers</p>
      <h1>Build the sites California charges on.</h1>
      <p class="lead">Steady multi-site work across the state, our own equipment and a crew that self-performs from first dig to power-on. Apprentices come up through the WECA program.</p>
    </div>
    <div>
      <div class="roles">
        <div class="role"><h3>Journeyman electrician</h3><span class="label">Field</span><p>Conduit, wire pulls, terminations and gear sets on EV and BESS sites.</p></div>
        <div class="role"><h3>Apprentice electrician</h3><span class="label">Field</span><p>Earn while you learn through WECA, working alongside our journeymen.</p></div>
        <div class="role"><h3>Operations and compliance coordinator</h3><span class="label">Office</span><p>Certified payroll, submittals and job documentation.</p></div>
      </div>
      <p style="margin-top:16px;color:var(--muted)">Send your resume to <b style="color:var(--ink)">info@potentialelectrical.com</b> with the role in the subject line.</p>
    </div>
  </div>
</div></section>
<div class="ctaband"><div class="wrap">
  <h2>Have a plan set? We'll price it.</h2>
  <a class="btn" href="/contact/">Request a bid</a>
</div></div>
</Base>
