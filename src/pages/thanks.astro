---
import Base from '../layouts/Base.astro';
---
<Base title="Request Received" description="Thanks for your bid request. We respond within one business day." path="/thanks/">
<section><div class="wrap">
  <div class="sec-head">
    <p class="label">Request a bid</p>
    <h1>Thanks. We have your request.</h1>
    <p class="lead">We'll come back within one business day with scope questions or a bid schedule. For anything urgent, email info@potentialelectrical.com.</p>
    <div class="cta-row"><a class="btn btn-primary" href="/work/">See recent work</a><a class="btn btn-ghost" href="/">Back to home</a></div>
  </div>
</div></section>
</Base>
